{
  "name": "homeroom-maps-198250",
  "version": "1.0.0",
  "private": true,
  "description": "Homeroom Maps",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run build:css && npm run build:map",
    "build:css": "tailwindcss -c tailwind.config.js -i styles/tailwind-input.css -o public/tailwind.css --minify",
    "build:map": "mkdir -p public/vendor/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl.js node_modules/maplibre-gl/dist/maplibre-gl.css node_modules/maplibre-gl/dist/LICENSE.txt public/vendor/maplibre/"
  },
  "dependencies": {
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "maplibre-gl": "^5.24.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
