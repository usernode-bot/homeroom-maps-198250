{
  "name": "Homeroom Maps",
  "description": "A global map and location platform built together with its community.",
  "secrets": [
    {
      "key": "SEARCH_PROVIDER",
      "description": "Which search provider adapter to use (photon, nominatim, pelias, mapbox, google, here). Defaults to photon, which needs no key.",
      "required": false,
      "default": "photon"
    },
    {
      "key": "PHOTON_URL",
      "description": "Base URL of the Photon instance. Defaults to the public demo server; point it at a self-hosted instance to scale past its soft limits.",
      "required": false,
      "default": "https://photon.komoot.io"
    }
  ],
  "visibility": {
    "build": "private",
    "view": "public"
  },
  "tests": [
    {
      "id": "home.map",
      "name": "Home map renders",
      "path": "/#/",
      "expectSelector": "[data-map-canvas]",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/js/**",
        "public/js/map/**",
        "public/js/services/map.js",
        "styles/**",
        "tailwind.config.js",
        "Dockerfile",
        "package.json"
      ],
      "allowConsoleErrors": true
    },
    {
      "name": "Home shows map attribution",
      "path": "/#/",
      "expectText": "OpenStreetMap",
      "allowConsoleErrors": true
    },
    {
      "name": "Home map not-configured state",
      "path": "/#/?map=unconfigured",
      "expectText": "Map is not configured yet"
    },
    {
      "name": "Search bar renders on Home",
      "path": "/#/",
      "expectSelector": "[data-search-input]"
    },
    {
      "name": "Discover opens",
      "path": "/#/discover",
      "expectText": "Places and points of interest will appear here."
    },
    {
      "name": "Directions opens",
      "path": "/#/directions",
      "expectText": "Route planning and navigation will appear here."
    },
    {
      "name": "Community opens",
      "path": "/#/community",
      "expectText": "Proposals"
    },
    {
      "name": "Profile opens",
      "path": "/#/profile",
      "expectText": "Appearance"
    }
  ],
  "permissions": [
    {
      "capability": "geolocation",
      "reason": "Shows your location on the map"
    }
  ]
}
