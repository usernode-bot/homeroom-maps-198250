{
  "name": "Homeroom Maps",
  "description": "A global map and location platform built together with its community.",
  "icon": {
    "image": "brand/icon.jpg",
    "emoji": "🗺️"
  },
  "secrets": [
    {
      "key": "SEARCH_PROVIDER",
      "description": "Which search provider adapter to use (photon, nominatim, pelias, mapbox, google, here). Defaults to photon, which needs no key.",
      "required": false,
      "default": "photon"
    },
    {
      "key": "PHOTON_URL",
      "description": "Base URL of the Photon instance. Defaults to the public demo server; point it at a self-hosted instance to scale past its soft limits.",
      "required": false,
      "default": "https://photon.komoot.io"
    },
    {
      "key": "ROUTING_PROVIDER",
      "description": "Which routing provider adapter to use (osrm, valhalla, graphhopper). Defaults to osrm, which needs no key.",
      "required": false,
      "default": "osrm"
    },
    {
      "key": "OSRM_URL",
      "description": "Base URL of the OSRM server. Defaults to the public demo server; point it at a self-hosted instance to scale past its soft limits.",
      "required": false,
      "default": "https://router.project-osrm.org"
    },
    {
      "key": "OSRM_PROFILES",
      "description": "Travel modes the OSRM server actually serves, as mode:profile pairs (comma separated, e.g. driving:driving,walking:foot,cycling:bike). A mode left out is refused as unsupported. The public demo server serves driving only.",
      "required": false,
      "default": "driving:driving"
    },
    {
      "key": "COMMUNITY_REVIEWERS",
      "description": "Comma-separated Homeroom usernames who may review community proposals (start review, accept, reject, mark implemented). Leave empty until reviewers are chosen; nobody can review while it is empty.",
      "required": false,
      "default": ""
    },
    {
      "key": "BUSINESS_REVIEWERS",
      "description": "Comma-separated Homeroom usernames who may review business claims (verify or reject, with the claim's contact details and evidence) and moderate business profiles (suspend or reinstate). Left empty, the business review queue falls back to COMMUNITY_REVIEWERS; empty there too means claims wait and nobody can review.",
      "required": false,
      "default": ""
    },
    {
      "key": "PLACE_PROVIDER",
      "description": "Which place-data provider adapter to use for per-place depth: photos, opening hours, phone, website, rating, business status. No adapter is implemented yet (Phase 3 ships the model, service and UI with honest Not-available states), so leaving this unset keeps /api/places answering 501 instead of serving fabricated POI data. Selection criteria, in order: (1) worldwide coverage of the place types the app surfaces, (2) per-place detail depth, (3) licensing that permits storing and displaying results, (4) cost at this app's scale, (5) the required credential declarable through the Secrets UI. When an adapter is implemented, its API key is declared in that change per the platform secrets convention.",
      "required": false
    },
    {
      "key": "OFFLINE_ENABLED",
      "description": "Operator switch for offline map areas (Phase 12A). Can only narrow the tile-provider permission gate (B2), never widen it: while the repository documents no bulk download rights for the configured provider, downloads stay off regardless of this value.",
      "required": false,
      "default": "true"
    },
    {
      "key": "OFFLINE_MAX_STORAGE_MB",
      "description": "Per-device storage budget for offline map areas, in megabytes. The Offline Areas screen reports actual usage against this budget.",
      "required": false,
      "default": "2048"
    },
    {
      "key": "OFFLINE_SEARCH_ENABLED",
      "description": "Operator switch for offline search (Phase 12B). Turned on by default. It is independent of the offline-download gate: searching regions a device has already stored is a device-local read, so it still works while tile downloads are closed. Setting it off makes the offline search states honest; online search is unaffected.",
      "required": false,
      "default": "true"
    },
    {
      "key": "LOCATION_SHARING_ENABLED",
      "description": "Operator switch for location sharing (Phase 12F). Turned on by default. Setting it off makes every /api/sharing route answer the honest not_configured 501 and the screen show its unavailable state; it can never change which code runs or widen what is shared.",
      "required": false,
      "default": "true"
    },
    {
      "key": "MAP_3D_ENABLED",
      "description": "Operator switch for the 3D camera (Phase 12H): pitch and bearing controls on the map. On by default; the camera adds no data source, only a view of tiles already loading. Set false to remove the 3D control.",
      "required": false,
      "default": "true"
    },
    {
      "key": "MAP_3D_MAX_PITCH",
      "description": "The steepest camera pitch the 3D control may apply, in degrees (0 to 85). Defaults to 60, MapLibre's own maximum. A malformed value falls back to 60.",
      "required": false,
      "default": "60"
    },
    {
      "key": "MAP_3D_TERRAIN_URL",
      "description": "DEM tile template for terrain elevation (Phase 12H), e.g. an AWS Mapzen Terrain Tiles terrarium endpoint ({z}/{x}/{y} PNG). Empty by default, which keeps terrain off. Terrain turns on only when an attribution line is also set.",
      "required": false,
      "default": ""
    },
    {
      "key": "MAP_TERRAIN_ATTRIBUTION",
      "description": "Attribution line required with the terrain tiles, naming the DEM data's copyright holders (for AWS Mapzen Terrain Tiles: Mapzen, Mapbox, OpenStreetMap). Terrain stays off while this is empty, whatever MAP_3D_TERRAIN_URL says.",
      "required": false,
      "default": ""
    },
    {
      "key": "WEATHER_PROVIDER",
      "description": "Which weather provider adapter to use for current conditions at the map centre (Phase 12G). No adapter is implemented yet, and no weather source is documented as authorized for this app, so leaving this unset keeps /api/weather/current answering 501 instead of serving made-up weather. A name alone is not enough either: the W1 gate additionally requires docs/weather-provider-rights.md to authorize the provider for live data with named evidence. Selection criteria, in order: (1) licensing that permits live use and display with attribution, (2) worldwide point coverage at the precision the panel shows, (3) cost at this app's scale, (4) the required credential declarable through the Secrets UI. When an adapter is implemented, its API key is declared in that change per the platform secrets convention.",
      "required": false
    },
    {
      "key": "TRAFFIC_ENABLED",
      "description": "Operator switch for the live traffic layer (Phase 12D). Can only narrow the live-traffic permission gate (T1), never widen it: while the repository documents no traffic-provider rights (docs/traffic-provider-rights.md does not exist) and no traffic adapter is implemented, live traffic stays honestly unavailable no matter how this is set. No traffic API key is declared here; the chosen provider's key gets declared in the same change that implements its adapter, per the platform secrets convention.",
      "required": false,
      "default": "true"
    },
    {
      "key": "API_ENABLED",
      "description": "Operator switch for the Developer API (Phase 12K). Setting it off turns the whole /api/v1 mount, both the read surface and the key-management surface, into a 503 api_disabled answer, without a redeploy.",
      "required": false,
      "default": "true"
    },
    {
      "key": "API_RATE_LIMIT_PER_MINUTE",
      "description": "Requests per minute per API key on /api/v1. A directions request costs 3 of these. Keys refill continuously; a spent key answers 429 with Retry-After.",
      "required": false,
      "default": "60"
    },
    {
      "key": "API_MAX_KEYS_PER_USER",
      "description": "How many ACTIVE API keys one person may hold at once. Revoking a key frees its slot.",
      "required": false,
      "default": "5"
    }
  ],
  "visibility": {
    "build": "private",
    "view": "public"
  },
