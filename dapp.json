{
  "name": "Homeroom Maps",
  "description": "A global map and location platform built together with its community.",
  "secrets": [
    {
      "key": "SEARCH_PROVIDER",
      "description": "Which search provider adapter to use (photon, nominatim, pelias, mapbox, google, here). Defaults to photon, which needs no key.",
      "required": false,
      "default": "photon"
    },
    {
      "key": "PHOTON_URL",
      "description": "Base URL of the Photon instance. Defaults to the public demo server; point it at a self-hosted instance to scale past its soft limits.",
      "required": false,
      "default": "https://photon.komoot.io"
    },
    {
      "key": "ROUTING_PROVIDER",
      "description": "Which routing provider adapter to use (osrm, valhalla, graphhopper). Defaults to osrm, which needs no key.",
      "required": false,
      "default": "osrm"
    },
    {
      "key": "OSRM_URL",
      "description": "Base URL of the OSRM server. Defaults to the public demo server; point it at a self-hosted instance to scale past its soft limits.",
      "required": false,
      "default": "https://router.project-osrm.org"
    },
    {
      "key": "OSRM_PROFILES",
      "description": "Travel modes the OSRM server actually serves, as mode:profile pairs (comma separated, e.g. driving:driving,walking:foot,cycling:bike). A mode left out is refused as unsupported. The public demo server serves driving only.",
      "required": false,
      "default": "driving:driving"
    },
    {
      "key": "COMMUNITY_REVIEWERS",
      "description": "Comma-separated Homeroom usernames who may review community proposals (start review, accept, reject, mark implemented). Leave empty until reviewers are chosen; nobody can review while it is empty.",
      "required": false,
      "default": ""
    },
    {
      "key": "PLACE_PROVIDER",
      "description": "Which place-data provider adapter to use for per-place depth: photos, opening hours, phone, website, rating, business status. No adapter is implemented yet (Phase 3 ships the model, service and UI with honest Not-available states), so leaving this unset keeps /api/places answering 501 instead of serving fabricated POI data. Selection criteria, in order: (1) worldwide coverage of the place types the app surfaces, (2) per-place detail depth, (3) licensing that permits storing and displaying results, (4) cost at this app's scale, (5) the required credential declarable through the Secrets UI. When an adapter is implemented, its API key is declared in that change per the platform secrets convention.",
      "required": false
    }
  ],
  "visibility": {
    "build": "private",
    "view": "public"
  },
  "tests": [
    {
      "id": "home.map",
      "name": "Home map renders",
      "path": "/#/",
      "expectSelector": "[data-map-canvas]",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/js/**",
        "public/js/map/**",
        "public/js/services/map.js",
        "styles/**",
        "tailwind.config.js",
        "Dockerfile",
        "package.json"
      ],
      "allowConsoleErrors": true
    },
    {
      "name": "Home shows map attribution",
      "path": "/#/",
      "expectText": "OpenStreetMap",
      "allowConsoleErrors": true
    },
    {
      "name": "Home map not-configured state",
      "path": "/#/?map=unconfigured",
      "expectText": "Map is not configured yet"
    },
    {
      "name": "Search bar renders on Home",
      "path": "/#/",
      "expectSelector": "[data-search-input]"
    },
    {
      "name": "Discover opens with place search",
      "path": "/#/discover",
      "expectSelector": "[data-places-search]"
    },
    {
      "name": "Discover shows the place search empty state",
      "path": "/#/discover",
      "expectText": "Find a place"
    },
    {
      "id": "places.discover",
      "name": "Discover places screen renders",
      "path": "/#/discover",
      "expectSelector": "[data-places-search]",
      "visual": true,
      "impact": [
        "public/js/screens/discover.js",
        "public/js/screens/place-detail.js",
        "public/js/components/place/**",
        "public/js/services/places-model.js",
        "public/js/services/places.js",
        "public/js/services/place-detail.js"
      ]
    },
    {
      "id": "directions.form",
      "name": "Directions form renders",
      "path": "/#/directions",
      "expectSelector": "[data-directions-form]",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/js/**",
        "public/js/screens/directions.js",
        "public/js/services/routing*.js",
        "public/js/components/route-summary.js",
        "routing/**",
        "styles/**",
        "tailwind.config.js",
        "Dockerfile",
        "package.json"
      ],
      "allowConsoleErrors": true
    },
    {
      "name": "Directions destination prefills from a place link",
      "path": "/#/directions?to=Berlin%2C52.52%2C13.405",
      "expectText": "Berlin"
    },
    {
      "id": "directions.navigationLink",
      "name": "Navigation deep link asks for a route first",
      "path": "/#/directions?navigate=1",
      "expectText": "Navigation needs a route",
      "visual": true,
      "impact": [
        "public/js/screens/directions.js",
        "public/js/components/navigation/**",
        "public/js/services/navigation.js",
        "public/js/services/navigation/**",
        "public/js/i18n/locales/en.js",
        "public/js/i18n/locales/id.js"
      ]
    },
    {
      "name": "Navigation deep link copy in Indonesian",
      "path": "/#/directions?navigate=1&lang=id",
      "expectText": "Navigasi butuh rute"
    },
    {
      "name": "Community opens",
      "path": "/#/community",
      "expectText": "Proposals"
    },
    {
      "id": "community.feed",
      "name": "Community feed lists proposals",
      "path": "/#/community",
      "expectSelector": "[data-community-feed][data-feed-state=\"ready\"] [data-proposal-row]",
      "visual": true,
      "impact": [
        "public/js/screens/community.js",
        "public/js/components/community/**",
        "public/js/services/community*.js",
        "community/**"
      ]
    },
    {
      "name": "Community Popular ranks open proposals by votes",
      "path": "/#/community?view=popular",
      "expectText": "Staging demo: ferry pier pin is too far east"
    },
    {
      "name": "Community Implemented view",
      "path": "/#/community?view=implemented",
      "expectText": "Staging demo: show cycle paths more clearly"
    },
    {
      "name": "Community Nearby asks for a location first",
      "path": "/#/community?view=nearby",
      "expectText": "See proposals near you"
    },
    {
      "name": "Community Yours is empty for a new visitor",
      "path": "/#/community?view=mine",
      "expectText": "You have not proposed anything yet"
    },
    {
      "name": "Community proposal detail opens with history",
      "path": "/#/community?proposal=900004",
      "expectSelector": "[data-proposal-detail=\"900004\"] [data-history]"
    },
    {
      "name": "Language picker renders on Profile",
      "path": "/#/profile",
      "expectText": "Language"
    },
    {
      "name": "Units picker renders on Profile",
      "path": "/#/profile",
      "expectText": "Units"
    },
    {
      "name": "Indonesian strings apply via the language override",
      "path": "/#/?lang=id",
      "expectText": "Tempat"
    },
    {
      "name": "Indonesian map copy via language override",
      "path": "/#/?map=unconfigured&lang=id",
      "expectText": "Peta belum dikonfigurasi"
    },
    {
      "name": "Profile opens",
      "path": "/#/profile",
      "expectText": "Appearance"
    },
    {
      "id": "trips.demo",
      "name": "Trip detail renders the demo itinerary",
      "path": "/#/trips?demo=1",
      "expectSelector": "[data-trip-detail] [data-trip-day] [data-trip-item]",
      "visual": true,
      "impact": [
        "public/js/screens/trips.js",
        "public/js/components/trips/**",
        "public/js/services/trips.js",
        "public/js/services/trips-core.js",
        "public/js/app.js",
        "public/js/screens/profile.js",
        "public/js/i18n/locales/en.js",
        "public/js/i18n/locales/id.js",
        "public/js/i18n/format.js",
        "public/js/map/adapter.js",
        "public/js/map/maplibre.js",
        "public/js/map/unsupported.js",
        "public/js/services/map.js",
        "trips/**"
      ],
      "allowConsoleErrors": true
    },
    {
      "name": "Trip list is empty for a new visitor",
      "path": "/#/trips",
      "expectText": "You have not created any trips yet"
    },
    {
      "name": "Trip deep link opens the demo trip",
      "path": "/#/trips?trip=900001&demo=1",
      "expectSelector": "[data-trip-detail='900001']",
      "allowConsoleErrors": true
    },
    {
      "name": "Trips copy in Indonesian",
      "path": "/#/trips?lang=id",
      "expectText": "Perjalanan"
    },
    {
      "name": "Trips entry renders on Profile",
      "path": "/#/profile",
      "expectText": "Trips"
    }
  ],
  "permissions": [
    {
      "capability": "geolocation",
      "reason": "Shows your location on the map"
    }
  ]
}
