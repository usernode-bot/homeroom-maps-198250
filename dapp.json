{
  "name": "Homeroom Maps",
  "description": "A global map and location platform built together with its community.",
  "secrets": [
    {
      "key": "SEARCH_PROVIDER",
      "description": "Which search provider adapter to use (photon, nominatim, pelias, mapbox, google, here). Defaults to photon, which needs no key.",
      "required": false,
      "default": "photon"
    },
    {
      "key": "PHOTON_URL",
      "description": "Base URL of the Photon instance. Defaults to the public demo server; point it at a self-hosted instance to scale past its soft limits.",
      "required": false,
      "default": "https://photon.komoot.io"
    },
    {
      "key": "ROUTING_PROVIDER",
      "description": "Which routing provider adapter to use (osrm, valhalla, graphhopper). Defaults to osrm, which needs no key.",
      "required": false,
      "default": "osrm"
    },
    {
      "key": "OSRM_URL",
      "description": "Base URL of the OSRM server. Defaults to the public demo server; point it at a self-hosted instance to scale past its soft limits.",
      "required": false,
      "default": "https://router.project-osrm.org"
    },
    {
      "key": "OSRM_PROFILES",
      "description": "Travel modes the OSRM server actually serves, as mode:profile pairs (comma separated, e.g. driving:driving,walking:foot,cycling:bike). A mode left out is refused as unsupported. The public demo server serves driving only.",
      "required": false,
      "default": "driving:driving"
    }
  ],
  "visibility": {
    "build": "private",
    "view": "public"
  },
  "tests": [
    {
      "id": "home.map",
      "name": "Home map renders",
      "path": "/#/",
      "expectSelector": "[data-map-canvas]",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/js/**",
        "public/js/map/**",
        "public/js/services/map.js",
        "styles/**",
        "tailwind.config.js",
        "Dockerfile",
        "package.json"
      ],
      "allowConsoleErrors": true
    },
    {
      "name": "Home shows map attribution",
      "path": "/#/",
      "expectText": "OpenStreetMap",
      "allowConsoleErrors": true
    },
    {
      "name": "Home map not-configured state",
      "path": "/#/?map=unconfigured",
      "expectText": "Map is not configured yet"
    },
    {
      "name": "Search bar renders on Home",
      "path": "/#/",
      "expectSelector": "[data-search-input]"
    },
    {
      "name": "Discover opens",
      "path": "/#/discover",
      "expectText": "Places and points of interest will appear here."
    },
    {
      "id": "directions.form",
      "name": "Directions form renders",
      "path": "/#/directions",
      "expectSelector": "[data-directions-form]",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/js/**",
        "public/js/screens/directions.js",
        "public/js/services/routing*.js",
        "public/js/components/route-summary.js",
        "routing/**",
        "styles/**",
        "tailwind.config.js",
        "Dockerfile",
        "package.json"
      ],
      "allowConsoleErrors": true
    },
    {
      "name": "Directions destination prefills from a place link",
      "path": "/#/directions?to=Berlin%2C52.52%2C13.405",
      "expectText": "Berlin"
    },
    {
      "name": "Community opens",
      "path": "/#/community",
      "expectText": "Proposals"
    },
    {
      "name": "Profile opens",
      "path": "/#/profile",
      "expectText": "Appearance"
    }
  ],
  "permissions": [
    {
      "capability": "geolocation",
      "reason": "Shows your location on the map"
    }
  ]
}
