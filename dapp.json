{
  "name": "Homeroom Maps",
  "description": "A global map and location platform built together with its community.",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🗺️"
  },
  "secrets": [
    {
      "key": "SEARCH_PROVIDER",
      "description": "Which search provider adapter to use (photon, nominatim, pelias, mapbox, google, here). Defaults to photon, which needs no key.",
      "required": false,
      "default": "photon"
    },
    {
      "key": "PHOTON_URL",
      "description": "Base URL of the Photon instance. Defaults to the public demo server; point it at a self-hosted instance to scale past its soft limits.",
      "required": false,
      "default": "https://photon.komoot.io"
    },
    {
      "key": "ROUTING_PROVIDER",
      "description": "Which routing provider adapter to use (osrm, valhalla, graphhopper). Defaults to osrm, which needs no key.",
      "required": false,
      "default": "osrm"
    },
    {
      "key": "OSRM_URL",
      "description": "Base URL of the OSRM server. Defaults to the public demo server; point it at a self-hosted instance to scale past its soft limits.",
      "required": false,
      "default": "https://router.project-osrm.org"
    },
    {
      "key": "OSRM_PROFILES",
      "description": "Travel modes the OSRM server actually serves, as mode:profile pairs (comma separated, e.g. driving:driving,walking:foot,cycling:bike). A mode left out is refused as unsupported. The public demo server serves driving only.",
      "required": false,
      "default": "driving:driving"
    },
    {
      "key": "COMMUNITY_REVIEWERS",
      "description": "Comma-separated Homeroom usernames who may review community proposals (start review, accept, reject, mark implemented). Leave empty until reviewers are chosen; nobody can review while it is empty.",
      "required": false,
      "default": ""
    },
    {
      "key": "PLACE_PROVIDER",
      "description": "Which place-data provider adapter to use for per-place depth: photos, opening hours, phone, website, rating, business status. No adapter is implemented yet (Phase 3 ships the model, service and UI with honest Not-available states), so leaving this unset keeps /api/places answering 501 instead of serving fabricated POI data. Selection criteria, in order: (1) worldwide coverage of the place types the app surfaces, (2) per-place detail depth, (3) licensing that permits storing and displaying results, (4) cost at this app's scale, (5) the required credential declarable through the Secrets UI. When an adapter is implemented, its API key is declared in that change per the platform secrets convention.",
      "required": false
    },
    {
      "key": "OFFLINE_ENABLED",
      "description": "Operator switch for offline map areas (Phase 12A). Can only narrow the tile-provider permission gate (B2), never widen it: while the repository documents no bulk download rights for the configured provider, downloads stay off regardless of this value.",
      "required": false,
      "default": "true"
    },
    {
      "key": "OFFLINE_MAX_STORAGE_MB",
      "description": "Per-device storage budget for offline map areas, in megabytes. The Offline Areas screen reports actual usage against this budget.",
      "required": false,
      "default": "2048"
    }
  ],
  "visibility": {
    "build": "private",
    "view": "public"
  },
  "tests": [
