+test('a migration that cannot finish changes nothing', { skip }, async () => {
+  const { pool: db } = await phase7Database('rollback');
+  await db.query(PHASE7_SCHEMA_SQL);
+  await db.query(`INSERT INTO saved_lists (user_id, name, kind, system_key, description) VALUES ('201', 'Favorites', 'default', 'favorites', 'kept')`);
