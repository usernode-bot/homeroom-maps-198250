+  await db.query('CREATE TABLE saved_places_phase7 (leftover INT)');
+  await assert.rejects(createStore({ pool: db }).migrate(), /saved_places_phase7/);
+  const cols = await db.query(
+    `SELECT column_name FROM information_schema.columns
+      WHERE table_schema = current_schema() AND table_name = 'saved_lists' AND column_name IN ('user_id', 'owner_id')`,
+  );
+  assert.deepEqual(cols.rows.map((r) => r.column_name), ['user_id']);
+  const kept = await db.query('SELECT description FROM saved_lists');
+  assert.deepEqual(kept.rows, [{ description: 'kept' }]);
+  const moved = await db.query(`SELECT to_regclass('saved_lists_phase7') AS t`);
+  assert.equal(moved.rows[0].t, null);
+});
