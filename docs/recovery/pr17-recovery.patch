+test('two boots at once copy Phase 7 exactly once', { skip }, async () => {
+  const { pool: db, name } = await phase7Database('race');
+  await db.query(PHASE7_SCHEMA_SQL);
+  const { rows } = await db.query(
+    `INSERT INTO saved_lists (user_id, name, kind, system_key) VALUES ('201', 'Favorites', 'default', 'favorites') RETURNING id`,
+  );
+  await db.query(`INSERT INTO saved_places (user_id, place_id, name, lat, lng) VALUES ('201', 'osm:node/30', 'Race cafe', 1, 2)`);
+  await db.query(`INSERT INTO saved_list_items (list_id, user_id, place_id) VALUES ($1, '201', 'osm:node/30')`, [rows[0].id]);
+  const other = new Pool({ connectionString: DB_URL, options: `-c search_path=${name}` });
+  extraPools.push(other);
+  await Promise.all([createStore({ pool: db }).migrate(), createStore({ pool: other }).migrate()]);
+  const n = await db.query('SELECT (SELECT count(*) FROM saved_lists)::int AS lists, (SELECT count(*) FROM saved_list_items)::int AS items');
+  assert.deepEqual(n.rows[0], { lists: 1, items: 1 });
+});
