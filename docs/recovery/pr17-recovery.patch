+// ── a second Phase 7 database per case, for the audit edge cases ──────────
+
+const extraSchemas = [];
+const extraPools = [];
+
+async function phase7Database(tag) {
+  const name = `${schema}_${tag}`;
+  const admin = new Pool({ connectionString: DB_URL });
+  await admin.query(`CREATE SCHEMA ${name}`);
+  await admin.end();
+  extraSchemas.push(name);
+  const p = new Pool({ connectionString: DB_URL, options: `-c search_path=${name}` });
+  extraPools.push(p);
+  return { name, pool: p };
+}
+
+test.after(async () => {
+  if (skip) return;
+  for (const p of extraPools) await p.end();
+  const admin = new Pool({ connectionString: DB_URL });
+  for (const name of extraSchemas) await admin.query(`DROP SCHEMA IF EXISTS ${name} CASCADE`);
+  await admin.end();
+});
+
+async function captureLog(fn) {
+  const lines = [];
+  const original = console.log;
+  console.log = (...args) => lines.push(args.join(' '));
+  try {
+    await fn();
+  } finally {
+    console.log = original;
+  }
+  return lines;
+}
+
+test('descriptions come across, a place in someone else\'s list stays its owner\'s, and nothing is dropped', { skip }, async () => {
+  const { pool: db } = await phase7Database('audit');
+  await db.query(PHASE7_SCHEMA_SQL);
+  const list = async (user, name, key, description) => (await db.query(
+    `INSERT INTO saved_lists (user_id, name, kind, system_key, description) VALUES ($1, $2, $3, $4, $5) RETURNING id`,
+    [user, name, key ? 'default' : 'custom', key, description],
+  )).rows[0].id;
+  const aliceTravel = await list('201', 'Travel', 'travel', 'Trips I still want to take');
+  const aliceEats = await list('201', 'Jakarta eats', null, 'Best warungs');
+  const bobFav = await list('202', 'Favorites', 'favorites', null);
+  const place = (user, id, name, lat, lng) => db.query(
+    `INSERT INTO saved_places (user_id, place_id, name, lat, lng, source) VALUES ($1, $2, $3, $4, $5, 'photon')`,
+    [user, id, name, lat, lng],
+  );
+  await place('201', 'osm:node/20', 'Warung Bu Sri', -6.2, 106.8);
+  await place('201', 'osm:node/21', 'Only in Bob\'s list', -6.21, 106.81);
+  await place('201', '-6.22,106.82', 'Coordinate spot', -6.22, 106.82);
+  await place('201', '-6.22000,106.82000', 'Coordinate spot again', -6.22, 106.82);
+  await place('201', 'osm:node/22', null, -6.23, 106.83);
+  await place('201', 'osm:node/23', 'Nowhere', null, null);
+  const member = (listId, user, placeId) => db.query(
+    'INSERT INTO saved_list_items (list_id, user_id, place_id) VALUES ($1, $2, $3)', [listId, user, placeId],
+  );
+  await member(aliceEats, '201', 'osm:node/20');
+  await member(bobFav, '201', 'osm:node/21'); // Phase 7's foreign key allowed this
+  await member(aliceTravel, '201', '-6.22,106.82');
+  await member(aliceTravel, '201', '-6.22000,106.82000');
+  await member(aliceTravel, '201', 'osm:node/22');
+  await member(aliceTravel, '201', 'osm:node/23');
+
+  const s = createStore({ pool: db });
+  const log = await captureLog(() => s.migrate());
+  assert.ok(
+    log.some((l) => l.includes('1 without coordinates, 1 without a name, 0 invalid, 1 duplicates')),
+    `log was: ${log.join('\n')}`,
+  );
+
+  const travel = await s.getDetail(ALICE, aliceTravel);
+  assert.equal(travel.list.description, 'Trips I still want to take');
+  assert.equal(travel.list.systemKey, 'travel');
+  assert.deepEqual(travel.items.map((i) => i.place.name), ['Coordinate spot']);
+  const eats = await s.getDetail(ALICE, aliceEats);
+  assert.equal(eats.list.description, 'Best warungs');
+  assert.equal(eats.list.systemKey, null);
+
+  // Bob's list never shows Alice's place; it lands in Alice's own
+  // "Saved places" list instead.
+  const bob = await s.getDetail(BOB, bobFav);
+  assert.deepEqual(bob.items, []);
+  assert.deepEqual(await s.listPlaces(BOB), []);
+  const mine = await s.listMine(ALICE, {});
+  const unlisted = mine.items.find((c) => c.name === 'Saved places');
+  const unlistedDetail = await s.getDetail(ALICE, unlisted.id);
+  assert.deepEqual(unlistedDetail.items.map((i) => i.place.name), ['Only in Bob\'s list']);
+
+  // Every Phase 7 row is still there, untouched.
+  const counts = await db.query(
+    `SELECT (SELECT count(*) FROM saved_lists_phase7)::int AS lists,
+            (SELECT count(*) FROM saved_places_phase7)::int AS places,
+            (SELECT count(*) FROM saved_list_items_phase7)::int AS items,
+            (SELECT count(*) FROM saved_lists_phase7 WHERE description IS NOT NULL)::int AS described`,
+  );
+  assert.deepEqual(counts.rows[0], { lists: 3, places: 6, items: 6, described: 2 });
+});
